{
  "name": "quiz-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MVP платформы интерактивных квизов в реальном времени",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "test": "node --test",
    "lint": "oxlint server client/src tests"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "socket.io-client": "^4.8.4"
  }
}
